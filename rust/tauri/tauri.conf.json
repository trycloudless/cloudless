{
  "productName": "CloudLess",
  "version": "0.6.0",
  "identifier": "com.cloudless.app",
  "build": {
    "beforeBuildCommand": "cd leptos_ui && trunk build",
    "frontendDist": "../leptos_ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CloudLess",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:* https://*.amazonaws.com https://*.trycloudless.io; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4M0FCMzgzMENBRjNFQTYKUldTbVBxOE1nN002ZVBqTFozd1NMNXhubWRPSldKQ1d1N3EvT2lxeHlHd3pJcm9uOXgxMlEzUmEK",
      "endpoints": [
        "https://cloudless-releases.s3.amazonaws.com/stable/latest-updater.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

# Database
DATABASE_URL=postgres://postgres:admin@localhost:54321/cloudless

# Server
HOST=0.0.0.0
PORT=9000

# JWT
JWT_SECRET=secret
JWT_ACCESS_TTL_SECS=1800

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# Logging (RUST_LOG format)
RUST_LOG=api_server=debug,tower_http=debug,core=debug

# Email backend: "log" (stdout, default), "ses", or "resend"
EMAIL_PROVIDER=log

# AWS SES (used when EMAIL_PROVIDER=ses)
# Key/secret optional — omit to use IAM role / default credential chain
SES_FROM_ADDRESS=noreply@example.com
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Resend (resend.com) — used when EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDRESS=noreply@example.com

# ── Media Storage (S3) ────────────────────────────────────────────────
# Used for blog image uploads. Leave blank to skip media upload support.
# MEDIA_S3_BUCKET=cloudless-media

# ── CORS ─────────────────────────────────────────────────────────────
# Extra allowed origins beyond the built-in Tauri + localhost set.
# Comma-separated. Example: CORS_ORIGINS=https://backup.example.com

# ── Billing ──────────────────────────────────────────────────────────
# "disabled" — no tier limits; all users get Pro-equivalent access (default)
# "enforce"  — tier limits active, no real payment provider (CI / test use)
BILLING_MODE=disabled

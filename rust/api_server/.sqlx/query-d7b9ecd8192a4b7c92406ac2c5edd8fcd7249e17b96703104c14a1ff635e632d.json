{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                bc.id as config_id,\n                bc.storage_id,\n                bc.local_device_id,\n                bc.encrypted_source_dir,\n                bc.source_dir_nonce,\n                bc.display_name,\n                bc.is_active,\n                bc.cleanup_type,\n                rs.storage_type,\n                rs.config,\n                ld.physical_device_id\n            FROM backup_config bc\n            JOIN remote_storages rs ON bc.storage_id = rs.id\n            JOIN local_devices ld ON bc.local_device_id = ld.id\n            WHERE bc.user_id = $1\n            ORDER BY bc.created_at DESC\n            ",

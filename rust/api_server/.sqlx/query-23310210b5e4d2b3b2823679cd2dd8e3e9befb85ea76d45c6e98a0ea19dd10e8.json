  "query": "\n            SELECT id, backup_config_id, overwrite_behavior, status,\n                   total_files, original_bytes, restored_bytes, started_at, completed_at\n            FROM restore_jobs\n            WHERE user_id = $1\n            ORDER BY started_at DESC\n            LIMIT $2 OFFSET $3\n            ",

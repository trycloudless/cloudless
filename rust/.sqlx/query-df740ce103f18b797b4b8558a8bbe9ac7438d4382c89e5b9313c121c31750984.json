{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.id,\n                u.name,\n                u.email,\n                u.created_at,\n                u.email_verified,\n                COALESCE(s.tier::text, 'free')   AS \"tier!: String\",\n                COALESCE(s.status::text, 'active') AS \"status!: String\"\n            FROM users u\n            LEFT JOIN subscriptions s ON s.user_id = u.id\n            ORDER BY u.created_at DESC\n            LIMIT $1 OFFSET $2\n            ",

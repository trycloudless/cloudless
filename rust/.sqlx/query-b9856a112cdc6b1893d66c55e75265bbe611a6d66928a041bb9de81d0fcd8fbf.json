{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT c.id, rvc.chunk_index, c.hash, c.size, c.storage_meta\n            FROM remote_file_version_chunks rvc\n            JOIN chunks c ON c.id = rvc.chunk_id\n            WHERE rvc.remote_file_version_id = $1 AND c.user_id = $2\n            ORDER BY rvc.chunk_index\n            ",

# CloudLess self-hosted configuration
# Copy to .env and fill in the required values before running docker compose up.
#
# Required fields have no default — docker compose will refuse to start without them.
# Optional fields show the default value that is used when unset.

# ── Database ──────────────────────────────────────────────────────────────────
# Used by both the Postgres container and the API connection string.
DB_PASSWORD=change_me_use_a_long_random_string

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. Must be at least 32 random characters.
# Generate one: openssl rand -hex 32
JWT_SECRET=change_me_use_openssl_rand_hex_32

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL where users reach your instance. Used in CORS headers and email links.
# Example for a local setup:  http://localhost:9000
# Example for a domain:       https://backup.yourdomain.com
FRONTEND_BASE_URL=http://localhost:9000

# API port exposed on the host (default 9000).
# API_PORT=9000

# Additional allowed CORS origins, comma-separated.
# Add your frontend domain when hosting behind a reverse proxy.
# CORS_ORIGINS=https://backup.yourdomain.com

# ── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER controls the email backend:
#   log     — print emails to stdout only (default; no real sends)
#   resend  — send via Resend (https://resend.com)
#   ses     — send via AWS SES
#
# EMAIL_PROVIDER=log

# Resend (set EMAIL_PROVIDER=resend to activate)
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDRESS=noreply@yourdomain.com

# AWS SES (set EMAIL_PROVIDER=ses to activate)
# SES_FROM_ADDRESS=noreply@yourdomain.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
